// @net/dns-lookup — DNS resolution for Zeta
// Ported from Rust crate dns-lookup v3.0.1
// License: MIT
// Repository: https://github.com/murphsicles/dns-lookup
//
// Provides DNS resolution for P2P seed node discovery and general networking.
// Maps to the Zeta runtime's host networking (getaddrinfo / system DNS).

use std.sys.net;

/// An IP address (IPv4 or IPv6).
pub enum IpAddr {
    V4([u8; 4]),
    V6([u8; 16]),
}

impl IpAddr {
    /// Create an IPv4 address from four octets.
    pub fn v4(a: u8, b: u8, c: u8, d: u8) -> IpAddr {
        return IpAddr::V4([a, b, c, d]);
    }

    /// Create an IPv6 address from 16 octets.
    pub fn v6(bytes: [u8; 16]) -> IpAddr {
        return IpAddr::V6(bytes);
    }

    /// Return true if this is an IPv4 address.
    pub fn is_ipv4(&self) -> bool {
        return match self {
            IpAddr::V4(_) => true,
            IpAddr::V6(_) => false,
        };
    }

    /// Return true if this is an IPv6 address.
    pub fn is_ipv6(&self) -> bool {
        return match self {
            IpAddr::V6(_) => true,
            IpAddr::V4(_) => false,
        };
    }

    /// Format as a string.
    pub fn to_string(&self) -> string {
        return match self {
            IpAddr::V4(octets) => {
                let mut s = string::new();
                s += octets[0];
                s += ".";
                s += octets[1];
                s += ".";
                s += octets[2];
                s += ".";
                s += octets[3];
                s
            },
            IpAddr::V6(_) => {
                // Simplified: just hex representation
                "[::]"
            },
        };
    }
}

/// Errors during DNS lookup.
pub enum LookupError {
    /// Hostname not found (NXDOMAIN).
    NotFound,
    /// Temporary DNS failure (try again).
    TemporaryFailure,
    /// System error (e.g., no network).
    SystemError(string),
}

impl LookupError {
    pub fn to_string(&self) -> string {
        return match self {
            LookupError::NotFound => "hostname not found",
            LookupError::TemporaryFailure => "temporary DNS failure",
            LookupError::SystemError(msg) => msg,
        };
    }
}

/// Result type for DNS lookups.
pub type Result<T> = std.result.Result<T, LookupError>;

/// Resolve a hostname to a list of IP addresses.
///
/// Performs a DNS A/AAAA lookup for the given hostname and returns all
/// resolved addresses. This is the primary function for P2P seed node
/// discovery in nour.
///
/// # Arguments
/// * `hostname` - The hostname to resolve (e.g., "seed.bitcoin.org")
///
/// # Returns
/// * `Ok(Vec<IpAddr>)` - List of resolved IP addresses
/// * `Err(LookupError)` - DNS resolution failure
///
/// # Example
/// ```zeta
/// const dns = @import("@net/dns-lookup");
/// const addrs = try dns.lookup_host("seed.bitcoin.org");
/// for addrs {
///     std.log.info("resolved: {s}", [.addr.to_string()]);
/// }
/// ```
pub fn lookup_host(hostname: &str) -> Result<Vec<IpAddr>> {
    // Delegate to the Zeta runtime's DNS resolution
    return std.sys.net.resolve_host(hostname, .Any);
}

/// Resolve a hostname to a single IP address.
///
/// Returns the first resolved address (preferring IPv4).
/// Useful when you only need one address for a connection.
///
/// # Arguments
/// * `hostname` - The hostname to resolve
///
/// # Returns
/// * `Ok(IpAddr)` - The first resolved IP address
/// * `Err(LookupError)` - DNS resolution failure
pub fn lookup_ip(hostname: &str) -> Result<IpAddr> {
    let addrs = std.sys.net.resolve_host(hostname, .Any);
    if addrs.is_empty() {
        return Result::Err(LookupError::NotFound);
    }
    // Prefer IPv4
    for addr in addrs {
        if addr.is_ipv4() {
            return Result::Ok(addr);
        }
    }
    return Result::Ok(addrs[0]);
}

/// Resolve a hostname to IPv4 addresses only.
pub fn lookup_host_v4(hostname: &str) -> Result<Vec<IpAddr>> {
    return std.sys.net.resolve_host(hostname, .V4Only);
}

/// Resolve a hostname to IPv6 addresses only.
pub fn lookup_host_v6(hostname: &str) -> Result<Vec<IpAddr>> {
    return std.sys.net.resolve_host(hostname, .V6Only);
}

/// Perform a reverse DNS lookup (IP to hostname).
pub fn lookup_addr(addr: &IpAddr) -> Result<string> {
    return std.sys.net.resolve_addr(addr);
}
